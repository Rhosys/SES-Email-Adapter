<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="{{theme.text}}" line-height="1.6" />
      <mj-button font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14px" font-weight="600" />
    </mj-attributes>
    <mj-style>
      .card-link { color: inherit; text-decoration: none; }
      .card-link:hover { text-decoration: none; }
      .label-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; vertical-align: middle; }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{theme.base}}">
    <!-- Logo mark -->
    <mj-section padding="32px 20px 0">
      <mj-column>
        <mj-image width="36px" height="36px" src="https://{{domain}}/favicon.svg" alt="Numaeel" align="left" />
      </mj-column>
    </mj-section>

    <!-- Header card -->
    <mj-section background-color="{{theme.mantle}}" border-radius="12px 12px 0 0" padding="32px 28px 16px">
      <mj-column>
        <mj-text font-size="22px" font-weight="600" color="{{theme.text}}" padding-bottom="4px" letter-spacing="-0.02em">
          {{subject}}
        </mj-text>
        <mj-raw>{{#hasThreads}}</mj-raw>
        <mj-text font-size="14px" color="{{theme.subtext}}">
          {{threadCount}} active conversations.
        </mj-text>
        <mj-raw>{{/hasThreads}}</mj-raw>
        <mj-raw>{{^hasThreads}}</mj-raw>
        <mj-text font-size="14px" color="{{theme.subtext}}">
          No new conversations since your last digest.
        </mj-text>
        <mj-raw>{{/hasThreads}}</mj-raw>
      </mj-column>
    </mj-section>

    <!-- Thread cards -->
    <mj-raw>{{#cards}}</mj-raw>
    <mj-section background-color="{{theme.mantle}}" padding="0 20px">
      <mj-column background-color="{{theme.crust}}" border-radius="8px" padding="14px 16px">
        <!-- Row 1: Emoji + Sender + Time -->
        <mj-text padding="0" font-size="14px">
          <a href="{{threadUrl}}" class="card-link" style="color: {{theme.text}}; text-decoration: none;">
            <span style="font-size: 16px;">{{workflowEmoji}}</span>&nbsp;
            <strong>{{senderName}}{{^senderName}}{{senderAddress}}{{/senderName}}</strong>
            <span style="color: {{theme.overlay}}; font-size: 12px; float: right;">{{timestamp}}</span>
          </a>
        </mj-text>
        <!-- Row 2: Subject -->
        <mj-text padding="4px 0 0" font-size="14px" color="{{theme.text}}">
          <a href="{{threadUrl}}" style="color: {{theme.text}}; text-decoration: none;">{{subject}}</a>
        </mj-text>
        <!-- Row 3: Summary -->
        <mj-text padding="2px 0 0" font-size="12px" color="{{theme.subtext}}">
          {{summary}}
        </mj-text>
        <!-- Row 4: Workflow detail (inline panel one-liner) -->
        <mj-raw>{{#hasWorkflowDetail}}</mj-raw>
        <mj-text padding="6px 0 0" font-size="12px" color="{{theme.overlay}}">
          {{workflowDetail}}
        </mj-text>
        <mj-raw>{{/hasWorkflowDetail}}</mj-raw>
        <!-- Row 5: Labels + Urgency -->
        <mj-text padding="6px 0 0" font-size="11px" color="{{theme.overlay}}">
          <span style="text-transform: capitalize;">{{workflowLabel}}</span><!--
          -->{{#hasLabels}} · {{labels}}{{/hasLabels}}<!--
          -->{{#urgency}} · <span style="background-color: {{urgencyColor}}; color: #fff; padding: 1px 6px; border-radius: 4px; font-size: 10px; font-weight: 600; letter-spacing: 0.02em;">{{urgencyLabel}}</span>{{/urgency}}
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- Spacer between cards -->
    <mj-section background-color="{{theme.mantle}}" padding="0">
      <mj-column>
        <mj-spacer height="8px" />
      </mj-column>
    </mj-section>
    <mj-raw>{{/cards}}</mj-raw>

    <!-- Quarantine warning (conditional) -->
    <mj-raw>{{#quarantineCount}}</mj-raw>
    <mj-section background-color="{{theme.mantle}}" padding="12px 28px">
      <mj-column background-color="{{theme.crust}}" border-radius="8px" padding="12px 16px" border="1px solid {{theme.warning}}">
        <mj-text font-size="13px" color="{{theme.warning}}" padding-bottom="8px">
          ⚠️ You have {{quarantineCount}} emails awaiting review in quarantine.
        </mj-text>
        <mj-button background-color="{{theme.warning}}" color="{{theme.crust}}" href="https://{{domain}}/a/quarantine" border-radius="6px" inner-padding="8px 16px" font-size="12px">
          Review Quarantine
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-raw>{{/quarantineCount}}</mj-raw>

    <!-- Dashboard CTA -->
    <mj-section background-color="{{theme.mantle}}" border-radius="0 0 12px 12px" padding="16px 28px 32px">
      <mj-column>
        <mj-divider border-color="{{theme.divider}}" border-width="1px" padding="0 0 20px 0" />
        <mj-button background-color="{{theme.accent}}" color="{{theme.accentText}}" href="https://{{domain}}/a/" border-radius="8px" inner-padding="12px 24px">
          Open Dashboard
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
