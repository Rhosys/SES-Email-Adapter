<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="{{theme.text}}" line-height="1.6" />
      <mj-button font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14px" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{theme.base}}">
    <!-- Logo mark -->
    <mj-section padding="32px 20px 0">
      <mj-column>
        <mj-image width="36px" height="36px" src="https://{{domain}}/favicon.svg" alt="Numaeel" align="left" />
      </mj-column>
    </mj-section>

    <!-- Header card -->
    <mj-section background-color="{{theme.mantle}}" border-radius="12px 12px 0 0" padding="32px 28px 16px">
      <mj-column>
        <mj-text font-size="22px" font-weight="600" color="{{theme.text}}" padding-bottom="4px" letter-spacing="-0.02em">
          {{subject}}
        </mj-text>
        <mj-text font-size="14px" color="{{theme.subtext}}">
          Here's your latest activity summary.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Arc table -->
    <mj-section background-color="{{theme.mantle}}" padding="0 20px">
      <mj-column>
        <mj-table font-size="12px" color="{{theme.text}}" cellpadding="0" cellspacing="0">
          <tr style="background-color: {{theme.crust}}; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: {{theme.subtext}};">
            <th style="padding: 10px 8px; text-align: left; font-weight: 500;">Urgency</th>
            <th style="padding: 10px 8px; text-align: left; font-weight: 500;">Type</th>
            <th style="padding: 10px 8px; text-align: left; font-weight: 500;">From</th>
            <th style="padding: 10px 8px; text-align: left; font-weight: 500;">Summary</th>
            <th style="padding: 10px 8px; text-align: left; font-weight: 500;">Labels</th>
            <th style="padding: 10px 8px; text-align: left; font-weight: 500;">Last Signal</th>
          </tr>
          {{#arcs}}
          <tr style="border-bottom: 1px solid {{theme.divider}};">
            <td style="padding: 10px 8px;"><span style="background-color: {{urgencyColor}}; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 500; letter-spacing: 0.02em;">{{urgency}}</span></td>
            <td style="padding: 10px 8px;">{{workflowIcon}}</td>
            <td style="padding: 10px 8px; font-weight: 500;">{{sender}}</td>
            <td style="padding: 10px 8px; color: {{theme.subtext}};">{{summary}}</td>
            <td style="padding: 10px 8px; font-size: 10px; color: {{theme.overlay}};">{{labels}}</td>
            <td style="padding: 10px 8px; font-size: 11px; color: {{theme.overlay}}; font-family: 'Geist Mono', monospace;">{{timestamp}}</td>
          </tr>
          {{/arcs}}
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Quarantine warning (conditional) -->
    <mj-raw>{{#quarantineCount}}</mj-raw>
    <mj-section background-color="{{theme.mantle}}" padding="12px 28px">
      <mj-column background-color="{{theme.crust}}" border-radius="8px" padding="12px 16px" border="1px solid {{theme.warning}}">
        <mj-text font-size="13px" color="{{theme.warning}}" padding-bottom="8px">
          ⚠️ You have {{quarantineCount}} emails awaiting review in quarantine.
        </mj-text>
        <mj-button background-color="{{theme.warning}}" color="{{theme.crust}}" href="https://{{domain}}/a/quarantine" border-radius="6px" inner-padding="8px 16px" font-size="12px">
          Review Quarantine
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-raw>{{/quarantineCount}}</mj-raw>

    <!-- Dashboard CTA -->
    <mj-section background-color="{{theme.mantle}}" border-radius="0 0 12px 12px" padding="16px 28px 32px">
      <mj-column>
        <mj-divider border-color="{{theme.divider}}" border-width="1px" padding="0 0 20px 0" />
        <mj-button background-color="{{theme.accent}}" color="{{theme.accentText}}" href="https://{{domain}}/a/" border-radius="8px" inner-padding="12px 24px">
          Open Dashboard
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
