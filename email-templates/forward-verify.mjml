<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="{{theme.text}}" line-height="1.6" />
      <mj-button font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14px" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{theme.base}}">
    <!-- Logo mark -->
    <mj-section padding="32px 20px 0">
      <mj-column>
        <mj-image width="36px" height="36px" src="https://{{domain}}/favicon.svg" alt="Numaeel" align="left" />
      </mj-column>
    </mj-section>

    <!-- Content card -->
    <mj-section background-color="{{theme.mantle}}" border-radius="12px" padding="32px 28px 24px">
      <mj-column>
        <mj-text font-size="22px" font-weight="600" color="{{theme.text}}" padding-bottom="8px" letter-spacing="-0.02em">
          Verify your forwarding address
        </mj-text>
        <mj-text padding-bottom="16px">
          Confirm that you want emails forwarded to this address:
        </mj-text>
        <mj-text font-size="16px" font-weight="600" color="{{theme.accent}}" padding-bottom="24px" font-family="'Geist Mono', monospace">
          {{address}}
        </mj-text>
        <mj-button background-color="{{theme.accent}}" color="{{theme.accentText}}" href="{{verifyUrl}}" border-radius="8px" inner-padding="12px 24px">
          Verify Forwarding Address
        </mj-button>
        <mj-text font-size="13px" color="{{theme.subtext}}" padding-top="24px">
          <strong>Account ID</strong>: {{accountId}}
        </mj-text>
        <mj-divider border-color="{{theme.divider}}" border-width="1px" padding="16px 0" />
        <mj-text font-size="12px" color="{{theme.overlay}}">
          If you didn't request this, you can safely ignore this email. The verification link will expire.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
