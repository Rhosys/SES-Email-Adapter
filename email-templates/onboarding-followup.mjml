<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-class name="footer" font-size="12px" color="#6c757d" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8f9fa">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#212529">The Next Step</mj-text>
        <mj-text>Here's where you are with getting Numaeel set up:</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 20px">
      <mj-column>
        {{#steps}}
        <mj-text>{{indicator}} {{label}}</mj-text>
        {{/steps}}
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-weight="bold">👉 Next up: {{nextStepLabel}}</mj-text>
        <mj-button background-color="#0d6efd" color="#ffffff" href="https://{{domain}}/a/onboarding">Continue Setup</mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
