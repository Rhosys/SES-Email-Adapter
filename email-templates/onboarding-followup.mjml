<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" color="{{theme.text}}" line-height="1.6" />
      <mj-button font-family="'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14px" font-weight="600" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="{{theme.base}}">
    <!-- Logo mark -->
    <mj-section padding="32px 20px 0">
      <mj-column>
        <mj-image width="36px" height="36px" src="https://{{domain}}/favicon.svg" alt="Numaeel" align="left" />
      </mj-column>
    </mj-section>

    <!-- Content card -->
    <mj-section background-color="{{theme.mantle}}" border-radius="12px" padding="32px 28px 24px">
      <mj-column>
        <mj-text font-size="22px" font-weight="600" color="{{theme.text}}" padding-bottom="8px" letter-spacing="-0.02em">
          Your setup progress
        </mj-text>
        <mj-text padding-bottom="20px" font-size="14px" color="{{theme.subtext}}">
          Here's where you are with getting Numaeel ready:
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Steps list -->
    <mj-section background-color="{{theme.mantle}}" border-radius="0" padding="0 28px">
      <mj-column>
        <mj-raw>{{#steps}}</mj-raw>
        <mj-text font-size="14px" padding="6px 0" color="{{theme.text}}">
          <span style="display: inline-block; width: 24px; text-align: center;">{{{indicator}}}</span> {{label}}
        </mj-text>
        <mj-raw>{{/steps}}</mj-raw>
      </mj-column>
    </mj-section>

    <!-- Next step CTA -->
    <mj-section background-color="{{theme.mantle}}" border-radius="0 0 12px 12px" padding="20px 28px 32px">
      <mj-column>
        <mj-divider border-color="{{theme.divider}}" border-width="1px" padding="0 0 20px 0" />
        <mj-text font-size="15px" font-weight="600" color="{{theme.text}}" padding-bottom="16px">
          👉 Next up: {{nextStepLabel}}
        </mj-text>
        <mj-button background-color="{{theme.accent}}" color="{{theme.accentText}}" href="https://{{domain}}/a/onboarding" border-radius="8px" inner-padding="12px 24px">
          Continue Setup
        </mj-button>
        <mj-text font-size="13px" color="{{theme.subtext}}" padding-top="24px">
          {{#accountName}}<strong>Account</strong>: {{accountName}}<br>{{/accountName}}
          <strong>Account ID</strong>: {{accountId}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
