<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="14px" color="#333333" line-height="1.5" />
      <mj-class name="footer" font-size="12px" color="#6c757d" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8f9fa">
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text font-size="22px" font-weight="bold" color="#212529">Verify your calendar forwarding address</mj-text>
        <mj-text>Click the link below to verify that you want to receive calendar forwarding at <strong>{{address}}</strong>.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0 20px 20px">
      <mj-column>
        <mj-button background-color="#0d6efd" color="#ffffff" href="{{verifyUrl}}">Verify Address</mj-button>
        <mj-text font-size="12px" color="#6c757d">If you did not request this, you can ignore this email.</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./_footer.mjml" />
  </mj-body>
</mjml>
