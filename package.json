{
  "name": "ses-email-adapter",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && drizzle-kit check && vitest run",
    "test": "tsc --noEmit -p tsconfig.check.json && vitest run",
    "dev": "tsc --watch",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx tests-integration/run.ts",
    "production:validation": "vitest run --config vitest.integration.config.ts",
    "test:llm-bedrock-classifier": "vitest run --config llm-tests/vitest.config.ts",
    "make": "tsx make.ts",
    "deploy": "tsx make.ts deploy",
    "db:generate": "drizzle-kit generate --name",
    "db:check": "drizzle-kit check",
    "lint": "eslint src/processor/",
    "openapi": "tsx scripts/openapi.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@authress/sdk": "^3.2.276",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1048.0",
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-lambda": "^3.1048.0",
    "@aws-sdk/client-rds-data": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-scheduler": "^3.0.0",
    "@aws-sdk/client-sesv2": "^3.0.0",
    "@aws-sdk/client-sfn": "^3.1048.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/s3-presigned-post": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hono/zod-openapi": "^1.3.0",
    "@types/web-push": "^3.6.4",
    "acorn": "^8.16.0",
    "dompurify": "^3.4.3",
    "drizzle-orm": "^0.45.2",
    "happy-dom": "^20.10.2",
    "hono": "^4.0.0",
    "ical.js": "^2.2.1",
    "jose": "^6.2.5",
    "jpeg-js": "^0.4.4",
    "json-logic-js": "^2.0.0",
    "json-stringify-safe": "^5.0.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "luxon": "^3.7.2",
    "mailparser": "^3.7.0",
    "mustache": "^4.2.0",
    "neverthrow": "^8.2.0",
    "pngjs": "^7.0.0",
    "quickjs-emscripten": "^0.32.0",
    "short-uuid": "^6.0.3",
    "tldts": "^7.0.28",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1067.0",
    "@aws-sdk/client-codebuild": "^3.1067.0",
    "@aws-sdk/client-kms": "^3.1048.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/dompurify": "^3.0.5",
    "@types/json-logic-js": "^2.0.0",
    "@types/json-stringify-safe": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/mailparser": "^3.4.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.19.19",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^2.0.0",
    "aws-architect": "^6.7.159",
    "aws-sdk-client-mock": "^4.1.0",
    "commander": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "mjml": "^5.3.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
